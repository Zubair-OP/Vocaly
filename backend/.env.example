GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=optional_fallback_key
GROQ_MODEL=openai/gpt-oss-120b
FRONTEND_ORIGIN=http://localhost:5173
OUTPUT_DIR=./outputs
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/vocally
MONGO_DATABASE=vocally
ENABLE_XTTS=false
# Set to 1 only after reviewing and accepting the XTTS non-commercial model license.
COQUI_TOS_AGREED=0
# Optional: local model cache, kept inside the project.
TTS_HOME=./outputs/models
