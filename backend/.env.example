GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GROQ_API_KEY=optional_fallback_key
GROQ_MODEL=openai/gpt-oss-120b
FRONTEND_ORIGIN=http://localhost:5173
OUTPUT_DIR=./outputs
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_AUDIO_FOLDER=vocally/audio
# Single-worker demo limits, shared by all visitors; counters reset on restart.
API_REQUESTS_PER_MINUTE=120
GENERATIONS_PER_HOUR=60
MAX_CONCURRENT_JOBS=2
# Admission threshold and reserved headroom; not a filesystem hard quota.
MEDIA_STORAGE_MB=1024
MEDIA_RESERVE_MB=64
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/vocally
MONGO_DATABASE=vocally
# Optional proxy for transcript requests. Leave blank for local direct access;
# configure a proxy URL in Render if YouTube blocks the service's outbound IP.
YOUTUBE_TRANSCRIPT_PROXY_URL=
MISTRAL_API_KEY=*******************
